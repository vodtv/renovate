{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Node.js Library 开源类库/SDK预设",
  "extends": ["./base"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "requiredStatusChecks": ["build", "lint", "test"]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
