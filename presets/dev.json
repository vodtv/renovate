{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "开发环境预设，小版本自动合并",
  "extends": ["./base"],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "requiredStatusChecks": ["build", "lint"]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
