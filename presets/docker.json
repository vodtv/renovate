{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["./base"],
  "labels": ["deps", "docker"],
  "commitMessagePrefix": "deps(docker)",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "requiredStatusChecks": ["build"]
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
